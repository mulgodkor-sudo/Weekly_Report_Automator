pause >nul
exit /b %RC%

:err_tmp
echo.
echo [ERROR] Could not create a temporary folder: "%WD%"
goto fail

:err_decode
echo.
echo [ERROR] Patch data could not be decoded. Nothing was changed.
echo         Download the patch file again and retry.
goto fail

:fail
